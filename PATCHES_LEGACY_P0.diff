+            part=sigmaJ2(f1,f2, [element[0], element[0]], h1-0.5,h2-0.5)  * integralvector[0]
+            for i in range(1,len(element)):
+                part=part+sigmaJ2(f1,f2, [element[0], element[i]], h1-0.5,h2-0.5)  * integralvector[i]
+                part=part+sigmaJ2(f1,f2, [element[i], element[0]], h1-0.5,h2-0.5)  * integralvector[-i]
+                          
+                
+            result[index] = result[index-1] +part
