+# -*- coding: utf-8 -*-
+"""
+Estimateurs de variance pour une séquence FARIMA(0,d,0)
+Compatibilité : Python 3.9 (pas de '|' dans les annotations)
+"""
+
+
+
+# ----------------------------- Utilitaires ----------------------------- #
+
+def _demean(x: np.ndarray) -> np.ndarray:
+    x = np.asarray(x, dtype=float)
+    return x - np.mean(x)
+
+
+def _taper_welch(n: int) -> np.ndarray:
+    """
+    Fenêtre de Welch (parabole) de longueur n :
+    w_t = 1 - ((t - (n-1)/2) / ((n+1)/2))^2
+    """
+    t = np.arange(n, dtype=float)
+    return 1.0 - ((t - (n - 1) / 2.0) / ((n + 1) / 2.0)) ** 2
+
+
+# ----------------------- Estimateur de variance ------------------------ #
+
+def estimate_variance_farima(
+    x,
+    method: str = "unbiased",
+    centre: bool = True,
+    taper: Optional[str] = None,
+) -> float:
+    """
+    Estime Var[X_t] (lag 0) à partir d'une réalisation x de FARIMA(0,d,0).
+
+    Paramètres
+    ----------
+    x : array_like
+        Réalisation 1D (fGn simulée, par ex. via FARIMA(0,d,0)).
+    method : {'unbiased','tapered','mad'}
+        - 'unbiased' : variance empirique centrée (ddof=1 si centre=True, sinon 0).
+        - 'tapered'  : applique une fenêtre (Welch) puis variance centrée
+                       avec correction d'énergie ⟨w^2⟩.
+        - 'mad'      : estimateur robuste via MAD (≈ variance sous gaussien).
+    centre : bool
+        Centre la série avant calcul (recommandé).
+    taper : {None,'welch'}
+        Taper multiplicatif avant variance (utile si method='tapered').
+
+    Retour
+    ------
+    var_hat : float
+        Estimation de la variance (lag 0).
+    """
+    x = np.asarray(x, dtype=float)
+    n = x.size
+    if n < 2:
+        raise ValueError("Il faut au moins 2 observations pour estimer la variance.")
+
+    if method not in {"unbiased", "tapered", "mad"}:
+        raise ValueError("method doit être 'unbiased', 'tapered' ou 'mad'.")
+
+    if method == "mad":
+        # Estimateur robuste : Var ≈ (MAD / Φ^{-1}(0.75))^2
+        med = np.median(x)
+        mad = np.median(np.abs(x - med))
+        # Φ^{-1}(0.75) ≈ 0.67448975
+        sigma = mad / 0.6744897501960817
+        return float(sigma * sigma)
+
+    # Méthodes basées sur la variance empirique
+    y = x.copy()
+
+    if taper is not None:
+        if taper.lower() == "welch":
+            w = _taper_welch(n)
+            y = y * w
+        else:
+            raise ValueError("taper inconnu. Utilise None ou 'welch'.")
+
+        # Après taper, on recalcule le centrage si demandé
+        if centre:
+            y = y - np.mean(y)
+
+        # Correction d'énergie moyenne du taper pour ne pas biaiser la variance
+        w2_mean = np.mean(w ** 2)
+        ddof = 1 if centre else 0
+        var_raw = np.var(y, ddof=ddof)
+        return float(var_raw / (w2_mean if w2_mean > 0 else 1.0))
+
+    # Sans taper
+    if centre:
+        return float(np.var(y, ddof=1))
+    else:
+        return float(np.var(y, ddof=0))
+
+
+# ----------------- IC via bootstrap en blocs (optionnel) ---------------- #
+
+def variance_ci_block_bootstrap(
+    x,
+    B: int = 500,
+    block_len: Optional[int] = None,
+    alpha: float = 0.05,
+    estimator_kwargs: Optional[Dict] = None,
+    rng: Optional[np.random.Generator] = None,
+) -> Tuple[float, Tuple[float, float]]:
+    """
+    Intervalle de confiance (IC) pour Var[X_t] via bootstrap en blocs (simple).
+    Utile avec dépendance (FARIMA).
+
+    Paramètres
+    ----------
+    x : array_like
+        Réalisation 1D.
+    B : int
+        Nombre de rééchantillonnages bootstrap.
+    block_len : int | None
+        Longueur de bloc (par défaut ~ n^{1/3}).
+    alpha : float
+        Niveau (0.05 => IC à 95%).
+    estimator_kwargs : dict | None
+        Arguments passés à estimate_variance_farima (ex: {'method':'tapered','taper':'welch'}).
+    rng : np.random.Generator | None
+        Générateur aléatoire pour reproductibilité.
+
+    Retour
+    ------
+    (var_hat, (lo, hi))
+        var_hat : estimateur sur x,
+        (lo, hi) : bornes de l'IC par percentiles.
+    """
+    x = np.asarray(x, dtype=float)
+    n = x.size
+    if n < 10:
+        raise ValueError("Série trop courte pour bootstrap (n >= 10).")
+
+    if rng is None:
+        rng = np.random.default_rng(1234)
+    if estimator_kwargs is None:
+        estimator_kwargs = {}
+
+    # Estimation sur l'échantillon d'origine
+    var_hat = estimate_variance_farima(x, **estimator_kwargs)
+
+    # Taille des blocs
+    if block_len is None:
+        block_len = max(5, int(round(n ** (1.0 / 3.0))))
+    block_len = int(block_len)
+    n_blocks = int(np.ceil(n / block_len))
+
+    vals = []
+    for _ in range(B):
+        # indices de départ aléatoires pour blocs non chevauchants
+        starts = rng.integers(0, max(1, n - block_len + 1), size=n_blocks)
+        pieces = [x[s: s + block_len] for s in starts]
+        xb = np.concatenate(pieces)[:n]
+        vals.append(estimate_variance_farima(xb, **estimator_kwargs))
+
+    vals = np.array(vals, dtype=float)
+    lo = float(np.quantile(vals, alpha / 2.0))
+    hi = float(np.quantile(vals, 1.0 - alpha / 2.0))
     return float(var_hat), (lo, hi)
