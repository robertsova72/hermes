+        part= sigmaJ2(f,f, [element[0], element[0]], h1-0.5,h1-0.5) * integralvector[0]
+        for i in range(1,len(element)):
+            part=part+2*sigmaJ2(f,f, [element[0], element[i]], h1-0.5,h1-0.5) * integralvector[i]
+        result[index] = result[index-1] +part
+     
+    
+
+    
+    result=np.asarray(result)/statistics.stdev(np.diff(result))
+    result = np.append( [0], result)
+    
+    return result
