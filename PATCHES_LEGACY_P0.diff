+import pywt
+import scipy.integrate as integrate
+import matplotlib.pyplot as plt
+import numpy as np
+
+
+# Parameters
+wavelet_name = 'dmey'  # Discrete Meyer wavelet
+scale = 10  # Meyer wavelet scale
+
+# isolement de la fonction d'échelle
+wavelet = pywt.Wavelet(wavelet_name)
+phi, _, x = wavelet.wavefun(level=scale)
+# mettre 0 au centre de l'intervalle
+y = x[0:len(x)//2+1]
+z = y[1:len(y)]
+w = -z[::-1]
+t = np.concatenate([w, y])
+#
+t0 = t[0]
+dt = t[1]-t[0]
+
+#Compute Fourier transform by numpy's FFT function
+g = np.fft.fft(phi)
+#frequency normalization factor is 2*np.pi/dt
+www = np.fft.fftfreq(phi.size)*2*np.pi/dt
+
+#In order to get a discretisation of the continuous Fourier transform
+#we need to multiply g by a phase factor
+g*=dt*np.exp(-complex(0,1)*www*t0)/(np.sqrt(2*np.pi))
+
+valeurs_uniques, indices_uniques = np.unique(www, return_index=True)
+xi = www[indices_uniques]
+fphi = np.real(g[indices_uniques])
+
+indices = np.where(np.abs(xi) <= 4 * np.pi / 3)[0]
+
+#### fractional scaling function
+xii = xi[indices]
+fphii = fphi[indices]
+n = len(xii)
+####
+
+############################################################# ordre2
+
+def genintegrand(p,d1,d2):
+    intermediate = np.abs(np.sinc(xii / 2 / np.pi)) ** (d1+d2) *  np.abs(fphii) ** 2
+    return np.exp(1j * xii * (p+(d2-d1)/2)) * intermediate
+
+def genintegral2(p,d1,d2):
+    return np.real(integrate.simpson(genintegrand(p,d1,d2), x=xii))
+
+def genintegrals2(h1,h2,elar):
+    print("Computation of the integrals for the Rosenblatt process")
+    integralvector=[0]*(elar+1)
+    for i in range(len(integralvector)):
+        integralvector[i]=genintegral2(i, h1-0.5,h2-0.5)
+    print("Integrals done!")
+    return integralvector
+
+
+
+############################################################### ordre 3
+
+
+def genfphiz(x, y, p, d2,d3):
+    a1 = np.sinc(y / 2 / np.pi) 
+    b1 = np.sign(a1) * (np.abs(a1)) ** d3
+    a2=np.sinc((x-y) / 2 / np.pi)
+    b2 = np.sign(a2) * (np.abs(a2)) ** d2
+    c = np.exp(1j * y * (p+(d3-d2)/2)) * b1*b2
+    return c
+
+def genaux1(zeta):
+    if np.abs(zeta) > 4 * np.pi / 3:
+        res = 0
+    else:
+        indice = np.where( np.abs( xii - zeta) < 1e-10)[0][0]
+        res = fphii[indice]
+    return res
+
+
+def genbxi(x, p, d2,d3):
+    B = 0
+    for eta in xii:
+        a1 = genfphiz(x, eta, p, d2,d3)
+        a2 = genaux1(eta)
+        a3 = genaux1(x - eta)
+        a4 = a1 * a2 * a3
+        B += a4
+
+    return (8 * np.pi / 3 / n) * B
+
+
+
+def genintegral3(p, q, d1,d2,d3):
+    A = 0
+    for xi in xii:
+        a = np.sinc(xi / 2 / np.pi)
+        b = np.sign(a) * (np.abs(a)) ** d1
+        #print("b = ",  b)
+        c = np.exp(1j * xi * (q+(d2-d1)/2))
+        #print("c = ",  c)
+        f = genaux1(xi)
+        #print("f = ", f)
+        g = genbxi(xi, p, d2,d3)
+        #print("g = ",  g)
+        A += c * b * f * g
+    return np.real((8 * np.pi / 3 / n) * A)
+
+def genintegrals3(hl,h2,h3,elar):
+
+    print("Computation of the integrals for the Hermite process of order 3")
+    integralmatrix=np.zeros((elar+1,elar+1))
+    for i in range(-(elar+1),elar+1):
+        for j in range(-(elar+1),elar+1):
+            integralmatrix[i,j]=genintegral3(i,j, hl-0.5,h2-0.5,h3-0.5)
+    print("Integrals done!")
+    
+    return integralmatrix
+
+#################################################################
+
+def genintegration(d,h1,h2,h3,elar):
+    
+        
+    if d==2 :
+        return genintegrals2(h1,h2,elar)
+    else :
+        return genintegrals3(h1,h2,h3,elar)
+
