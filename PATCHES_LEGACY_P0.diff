+def standard(n1,n2,n3,Hmin,Hmax,J,Ij,elar,time,step):
+    
+    simu=np.zeros(((n1+n2+n3)*step,len(time)+1))
+    
+    for j in range(step):
+        if(step>1):H=Hmin+j*(Hmax-Hmin)/(step-1)
+        else:H=Hmin
+        
+        if(n1>0):
+            print(f"-----------------------Simulation(s) of the Fractional Brownian motion with Hurst parameter {H:.2f}-----------------------")
+        
+            for i in range(n1):
+                print(f"Simulation of the path {i+1:.0f} over {n1:.0f}")
+                simu[(n1+n2+n3)*j+i]= 2 ** (- J * H) *np.array(Brownian(H,Ij))
+                print(f"Simulation of the path {i+1:.0f} over {n1:.0f} completed")
+        
+            
+
+        if(n2>0):
+            print(f"-----------------------Simulation(s) of the Rosenblatt process with Hurst parameter {H:.2f}-----------------------")
+            ############## first computation of the integrals
+            integral2=integration(2,H,elar)
+        
+        
+            for i in range(n2):
+                print(f"Simulation of the path {i+1:.0f} over {n2:.0f}")
+                simu[(n1+n2+n3)*j+n1+i]= 2 ** (- J * H) *np.array(Rosenblatt(1+((H-1)/2),elar,Ij,integral2))
+                print(f"Simulation of the path {i+1:.0f} over {n2:.0f} completed")
+            
+            
+
+        if(n3>0):
+            print(f"-----------------------Simulation(s) of the Hermite process of order 3 with Hurst parameter {H:.2f}-----------------------")
+            
+            integral3=integration(3,H,elar)
+                
+            for i in range(n3):
+                print(f"Simulation of the path {i+1:.0f} over {n3:.0f} ")
+                simu[(n1+n2+n3)*j+n1+n2+i]= 2 ** (- J *H) *np.array(Hermite3(1+((H-1)/3),elar,Ij,integral3))
+                print(f"Simulation of the path {i+1:.0f} over {n3:.0f} completed")
+           
+            
+           
+        
+    return simu 
