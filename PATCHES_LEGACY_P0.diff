+############################### SPLITER #######################################
+# take a matrix of simulations and select the ones at ranges betwwen a and b #
+##############################################################################
+
+def simulspliter(simu,a,b,time):
+    select=np.zeros((b-a+1,len(time)+1))
+    for i in range (b-a+1):
+        select[i]=simu[a+i]
+    
+    return select
+###############################INCREMENTS######################################
+# return a table whose elements are the increments of a simulated process######
+###############################################################################
