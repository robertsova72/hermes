+                        part=part+sigmaJ3(f1,f2,f3, [element[i], element[0],element[j]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[i,-j]
+                        part=part+sigmaJ3(f1,f2,f3, [element[j], element[0],element[i]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[j,-i]
+                        part=part+sigmaJ3(f1,f2,f3, [element[i], element[j],element[0]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[i-j,j]
+                        part=part+sigmaJ3(f1,f2,f3, [element[j], element[i],element[0]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[j-i,i]
+                
