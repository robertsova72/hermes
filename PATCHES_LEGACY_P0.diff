+def estimate_d_gph(x, m=None, taper='welch'):
+    """
+    Estimateur GPH (Geweke-Porter-Hudak) de d par régression log-périodogramme.
+    Paramètres
+    ---------
+    x : array_like
+        Série temporelle.
+    m : int or None
+        Nombre de fréquences basses à utiliser. Par défaut m = floor(n^0.5).
+    taper : {'welch', None}
+        Taper pour limiter la fuite spectrale.
+
+    Retour
+    ------
+    d_hat : float
+        Estimation de d.
+    """
+    x = np.asarray(x, dtype=float)
+    n = x.size
+    if n < 64:
+        raise ValueError("Série trop courte pour GPH (n >= 64 recommandé).")
+
+    y, _ = _apply_taper(x, taper=taper)
+    w, I = _periodogram(y)
+
+    # Choix m : prise classique m ~ n^0.5 (ou n^0.6)
+    if m is None:
+        m = int(np.floor(n**0.5))
+    m = max(5, min(m, I.size // 2))
+    w_m = w[:m]
+    I_m = I[:m]
+
+    # Régression: log I(w_j) = c - 2d * log(2*sin(w_j/2)) + erreur
+    z = np.log(2.0 * np.sin(w_m / 2.0))
+    y_reg = np.log(I_m)
+
+    X = np.vstack([np.ones_like(z), -2.0 * z]).T  # colonnes: 1, -2*z
+    beta, *_ = np.linalg.lstsq(X, y_reg, rcond=None)
+    # beta = [c_hat, d_hat], mais attention au signe:
+    # y = c + (-2d) z => coefficient sur z = -2 d => d_hat = -(coef_z)/2
+    coef_z = beta[1]
+    d_hat = coef_z
+    return float(d_hat)
+
+
+def estimate_d(x, method='local_whittle', m=None, taper='welch'):
+    """
+    Wrapper générique pour estimer d sur une FARIMA(0,d,0).
+
+    method : {'local_whittle', 'gph'}
+        - 'local_whittle' : robuste, recommandé
+        - 'gph'          : plus simple/rapide
+    m : int or None
+        Bande passante (# fréquences basses). Sinon valeur par défaut raisonnable.
+    taper : {'welch', None}
+        Taper pour limiter la fuite spectrale.
+    """
+    method = method.lower()
+    if method == 'local_whittle':
+        return estimate_d_local_whittle(x, m=m, taper=taper)
+    elif method == 'gph':
+        return estimate_d_gph(x, m=m, taper=taper)
+    else:
+        raise ValueError("method inconnu. Utilise 'local_whittle' ou 'gph'.")
+        
