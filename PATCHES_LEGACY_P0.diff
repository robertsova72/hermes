+            for i in range(1,len(element)):
+                part=part+sigmaJ3(f1,f2,f3, [element[0], element[0],element[i]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[0,-i]
+                part=part+sigmaJ3(f1,f2,f3, [element[0], element[i],element[0]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[-i,i]
+                part=part+sigmaJ3(f1,f2,f3, [element[i], element[0],element[0]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[i,0]
+                part=part+sigmaJ3(f1,f2,f3, [element[0], element[i],element[i]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[-i,0]
+                part=part+sigmaJ3(f1,f2,f3, [element[i], element[0],element[i]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[i,-i]
+                part=part+sigmaJ3(f1,f2,f3, [element[i], element[i],element[0]], h1-0.5,h2-0.5,h3-0.5)  * integralmatrix[0,i]
