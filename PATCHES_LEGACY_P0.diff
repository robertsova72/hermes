+    
+
+    
+    
+    result = [0] * len(Ij)
+    result[0] = sigmaJ3(f,f,f, [Ij[0], Ij[0],Ij[0]], h1-0.5,h1-0.5,h1-0.5) * integralmatrix[0,0]
+    for index in range(1, len(Ij)):
+        element= epaissi(Ij[index],elar,Ij[0])
+        part= sigmaJ3(f,f,f, [element[0], element[0],element[0]], h1-0.5,h1-0.5,h1-0.5) * integralmatrix[0,0]
+        for i in range(1,len(element)):
+            part=part+3*sigmaJ3(f,f,f,  [element[0], element[0],element[i]], h1-0.5,h1-0.5,h1-0.5) * integralmatrix[0,i] 
+            part=part+3*sigmaJ3(f,f,f, [element[0], element[i],element[i]], h1-0.5,h1-0.5,h1-0.5) * integralmatrix[i,0]
+      
+            for j in range(i+1,len(element)):
+                part=part+6*sigmaJ3(f,f,f,  [element[0], element[i],element[j]], h1-0.5,h1-0.5,h1-0.5) * integralmatrix[i,j-i]
+        result[index] = result[index-1] +part
+    
+
+    
+    result=np.asarray(result)/statistics.stdev(np.diff(result))
+    result = np.append( [0], result)
