+    #set_seed = 42  # Pour rendre la simulation reproductible
+    #r('set.seed(42)')
+    nb = 2 ** (np.ceil(np.log2(Ij[-1]))) ## pour le nombre de terme pour simuler farima
+    f = farima_CME(nb, h1, 20, 1e-12, None)
+    f=(f-np.mean(f))
+    print("FARIMA Done!")
