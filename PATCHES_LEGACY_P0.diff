+def increments(simu,first):
+    if(first==False):i=2
+    else:i=1
+        
+    table=np.zeros((len(simu)-i))
+    
+    for k in range(len(table)):
+        table[k]=simu[k+i]-simu[k+i-1]
+  
+    return table
