+import numpy as np
+from scipy.special import gammaln
+from typing import Optional, Dict, Tuple
+
+
+
+def _acf_arfima0d0(n, d, unit_var=True):
+    """
+    ACF gamma(k), k=0..n, pour ARFIMA(0,d,0), calculée de façon stable via gammaln.
+    Si unit_var=True, renvoie une ACF *normalisée* telle que gamma(0)=1.
+    """
+    k = np.arange(n + 1, dtype=float)
+    # log C(d) = ln Γ(1-2d) - ln Γ(d) - ln Γ(1-d)
+    logC = gammaln(1.0 - 2.0*d) - (gammaln(d) + gammaln(1.0 - d))
+    # ln gamma(k) = logC + ln Γ(k+d) - ln Γ(k+1-d)
+    log_gk = logC + (gammaln(k + d) - gammaln(k + 1.0 - d))
+    g = np.exp(log_gk)
+
+    if unit_var:
+        # gamma(0) = Γ(1-2d)/Γ(1-d)^2  =>  log gamma(0) = logC + ln Γ(d) - ln Γ(1-d)
+        log_g0 = logC + (gammaln(d) - gammaln(1.0 - d))
+        g = np.exp(log_gk - log_g0)  # divise toute l'ACF par gamma(0)
+    return g
+
+def farima_CME(K, H, max_tries=20, tol=1e-12, rng=None):
+    """
+    Génère une fGn (FARIMA(0,d,0) avec d=H-1/2) de longueur K
+    avec *variance unitaire* au lag 0 (normalisation analytique).
+    Implémentation CME robuste (Wood–Chan/Davies–Harte).
+    """
+    if rng is None:
+        rng = np.random.default_rng()
+
+    d = float(H) - 0.5
+    if not (-0.5 < d < 0.5):
+        raise ValueError("H doit être dans (0,1) ⇒ d=H-0.5 dans (-0.5,0.5).")
+    if K < 1:
+        return np.zeros(0, dtype=float)
+
+    # Taille de l'embedding circulant (>= 2*(K-1))
+    p = int(np.ceil(np.log2(2 * (K - 1) if K > 1 else 1)))
+
+    for _ in range(max_tries):
+        m = 2**p
+        n = m // 2
+
+        # --- ACF normalisée : gamma(0)=1 ---
+        g = _acf_arfima0d0(n, d, unit_var=True)
+
+        # vecteur circulant z = [g0, g1, ..., g_{n}, g_{n-1}, ..., g1]
+        z = np.concatenate([g, g[-2:0:-1]])
+        w = np.fft.fft(z).real / m  # valeurs propres (théoriquement ≥0)
+
+        w_max = w.max()
+        eps = tol * (w_max if w_max > 0 else 1.0)
+
+        if w.min() < -eps:
+            # pas assez grand => on augmente l'embedding
+            p += 1
+            continue
+
+        # Rogne de minuscules négatifs dus à l'arrondi
+        w = np.maximum(w, 0.0)
+
+        # Bruit gaussien complexe i.i.d. ~ N(0,1) + i N(0,1)
+        xi = rng.standard_normal(m) + 1j * rng.standard_normal(m)
+        N = np.sqrt(w) * xi
+
+        S = np.fft.fft(N).real  # séquence réelle de covariance z
+        x = S[:int(K)]
+
+        # À ce stade: Var théorique ≈ 1 ; pas de renormalisation empirique
+        return x
+
+    raise RuntimeError("CME n'a pas obtenu un spectre PSD après "
+                       f"{max_tries} tentatives. Augmentez max_tries ou vérifiez 'tol'.")
+
+
+def _apply_taper(x, taper='welch'):
+    """
+    Applique un lissage multiplicatif (taper) pour réduire la fuite spectrale.
+    - 'welch' : w_t = 1 - ((t - (n-1)/2) / ((n+1)/2))^2
+    - None    : pas de taper
+    Retourne x_tapered (centré), et la moyenne soustraite.
+    """
+    x = np.asarray(x, dtype=float)
+    mu = x.mean()
+    y = x - mu
+    n = y.size
+    if taper is None:
+        return y, mu
+    if taper == 'welch':
+        t = np.arange(n)
+        w = 1.0 - ((t - (n - 1) / 2.0) / ((n + 1) / 2.0))**2
+        return y * w, mu
+    else:
+        raise ValueError("taper inconnu. Utilise 'welch' ou None.")
+
+
+def _periodogram(y):
+    """
+    Périodogramme non normalisé (échelle 2π) aux fréquences de Fourier positives.
+    Retourne (freqs, I) avec freqs = 2π*k/n, k=1..floor(n/2).
+    """
+    n = y.size
+    # FFT non normalisée
+    Y = np.fft.rfft(y)  # fréquences 0..n/2
+    # Retirer la fréquence zéro (k=0)
+    I = (np.abs(Y[1:])**2) / (2.0 * np.pi * n)  # échelle standard en long memory
+    k = np.arange(1, Y.size)                   # indices 1..n/2
+    freqs = 2.0 * np.pi * k / n
+    return freqs, I
+
+
+def estimate_d_local_whittle(x, m=None, taper='welch'):
+    """
+    Estimateur local-Whittle de d (Robinson, 1995) pour FARIMA(0,d,0).
+    Paramètres
+    ---------
+    x : array_like
+        Série temporelle (n échantillons).
+    m : int or None
+        Nombre de fréquences basses utilisées (bande passante). Par défaut m = floor(n^0.8).
+        Doit satisfaire 1 << m << n.
+    taper : {'welch', None}
+        Taper pour limiter la fuite spectrale (recommandé 'welch').
+
+    Retour
+    ------
+    d_hat : float
+        Estimation de d.
+    """
+    x = np.asarray(x, dtype=float)
+    n = x.size
+    if n < 64:
+        raise ValueError("Série trop courte pour l'estimation semi-paramétrique (n >= 64 recommandé).")
+
+    y, _ = _apply_taper(x, taper=taper)
+    w, I = _periodogram(y)  # w in (0, π], I >= 0
+
+    # Choix automatique de m si non fourni
+    if m is None:
+        m = int(np.floor(n**0.8))
+    m = max(5, min(m, I.size // 2))  # borne
+    w_m = w[:m]
+    I_m = I[:m]
+
+    # Fonction objectif Whittle local (profilée en sigma^2)
+    # Q(d) = log( (1/m) sum_{j=1}^m I(w_j) w_j^{2d} ) - (2d/m) * sum log w_j
+    logw = np.log(w_m)
+    Slogw = np.mean(logw)
+
+    def Q_of_d(d):
+        weights = np.exp(2.0 * d * logw)  # w_j^{2d}
+        S = np.mean(I_m * weights)
+        if S <= 0 or not np.isfinite(S):
+            return np.inf
+        return np.log(S) - 2.0 * d * Slogw
+
+    # Recherche 1D sur d dans (-0.49, 0.49)
+    # Grille initiale puis raffinement par golden-section.
+    d_lo, d_hi = -0.49, 0.49
+
+    # Grille grossière pour point de départ
+    grid = np.linspace(d_lo, d_hi, 61)
+    vals = np.array([Q_of_d(d) for d in grid])
+    j0 = np.nanargmin(vals)
+    # Encadrer autour du minimum grossier
+    a = max(d_lo, grid[max(0, j0 - 2)])
+    b = min(d_hi, grid[min(len(grid) - 1, j0 + 2)])
+
+    # Golden section search
+    phi = (1 + 5**0.5) / 2
+    invphi = 1 / phi
+    invphi2 = (1 / phi)**2
+    c = b - (b - a) * invphi
+    d = a + (b - a) * invphi
+    fc = Q_of_d(c)
+    fd = Q_of_d(d)
+    for _ in range(80):
+        if fc > fd:
+            a = c
+            c = d
+            fc = fd
+            d = a + (b - a) * invphi
+            fd = Q_of_d(d)
+        else:
+            b = d
+            d = c
+            fd = fc
+            c = b - (b - a) * invphi
+            fc = Q_of_d(c)
+        if abs(b - a) < 1e-6:
+            break
+
+    d_hat = 0.5 * (a + b)
+    return float(d_hat)
